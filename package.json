{
  "name": "@paulislava/support-bot",
  "version": "0.1.0",
  "description": "Multi-service support inbox with Telegram topics, app chat and email",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "bin": {
    "support-bot": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/*.test.mjs",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "nodemailer": "^10.0.16",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/node": "^22.18.6",
    "@types/nodemailer": "^7.0.2",
    "@types/pg": "^8.15.5",
    "typescript": "^5.9.3"
  }
}
